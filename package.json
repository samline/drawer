{
  "name": "@samline/drawer",
  "version": "4.0.0",
  "description": "Framework-agnostic drawer runtime with a vanilla/browser API and an IIFE bundle for direct CDN use.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://samline.github.io/drawer",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/browser/global.global.js",
    "./dist/style.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test"
  },
  "keywords": [
    "drawer",
    "browser",
    "vanilla-js",
    "dialog",
    "modal",
    "bottom-sheet"
  ],
  "author": "Samuel Olvera (samline)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/drawer.git"
  },
  "bugs": {
    "url": "https://github.com/samline/drawer/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18"
  }
}
