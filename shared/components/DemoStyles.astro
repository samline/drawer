---
import '@samline/drawer/styles.css'
---

<style is:global>
  .site-demo-overlay {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 45%);
    z-index: 201;
  }
  .site-demo-drawer {
    --demo-padding: 2rem;
    position: fixed;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text);
    z-index: 201;
    padding: var(--demo-padding);
    max-height: 90dvh;
    outline: none;
    font: 1rem/1.6 var(--font-sans);
  }
  .site-demo-drawer[data-drawer-direction='bottom'] {
    bottom: 0;
    left: 0;
    right: 0;
    border-radius: 1.5rem 1.5rem 0 0;
    min-height: 18rem;
  }
  .site-demo-drawer[data-drawer-direction='top'] {
    top: 0;
    left: 0;
    right: 0;
    border-radius: 0 0 1.5rem 1.5rem;
    min-height: 18rem;
  }
  .site-demo-drawer[data-drawer-direction='left'] {
    top: 0;
    bottom: 0;
    left: 0;
    width: min(28rem, 90vw);
    max-height: 100dvh;
  }
  .site-demo-drawer[data-drawer-direction='right'] {
    top: 0;
    bottom: 0;
    right: 0;
    width: min(28rem, 90vw);
    max-height: 100dvh;
  }
  .site-demo-drawer[data-drawer-snap-points='true'] {
    height: 100dvh;
    max-height: 100dvh;
  }
  .site-demo-drawer[data-drawer-snap-points='true'][data-drawer-direction='bottom'][data-state='open'] {
    padding-bottom: calc(var(--demo-padding) + var(--initial-transform, 0rem));
  }
  .site-demo-drawer [data-drawer-title],
  .site-demo-drawer [data-drawer-description] {
    flex-shrink: 0;
    width: min(100%, 52rem);
    margin-inline: auto;
    box-sizing: border-box;
  }
  .site-demo-drawer [data-drawer-title] {
    margin-block: 1rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.15;
    padding-right: 3rem;
  }
  .site-demo-drawer [data-drawer-description] {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }
  .site-demo-drawer {
    border: 0.0625rem solid var(--color-border);
  }
  .site-demo-drawer [data-drawer-body] {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-demo-drawer .demo-body {
    display: grid;
    gap: var(--space-lg);
    width: min(100%, 52rem);
    margin-inline: auto;
  }
  .site-demo-drawer .demo-body > .btn,
  .site-demo-drawer form > .btn {
    justify-self: start;
    width: fit-content;
    max-width: 100%;
  }
  .site-demo-drawer .demo-scene {
    display: grid;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }
  .site-demo-drawer .demo-scene-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1rem;
  }
  .site-demo-drawer .demo-scene-row + .demo-scene-row {
    border-top: 0.0625rem solid var(--color-border);
  }
  .site-demo-drawer .demo-scene-row p {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-top: 0.25rem;
  }
  .site-demo-drawer .demo-scene-row > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .site-demo-drawer .demo-menu {
    display: grid;
    gap: var(--space-sm);
  }
  .site-demo-drawer .demo-menu-item {
    justify-content: flex-start;
    width: 100%;
    text-align: left;
    padding: 1rem;
    gap: 1rem;
  }
  .site-demo-drawer .demo-menu-item[hidden] {
    display: none;
  }
  .site-demo-drawer .demo-menu-copy {
    display: grid;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .site-demo-drawer .demo-menu-copy > span,
  .site-demo-drawer .demo-hint {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .site-demo-drawer .demo-menu-icon {
    display: grid;
    place-items: center;
    flex: 0 0 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-accent);
    font-size: 1.25rem;
  }
  .site-demo-drawer .demo-kicker {
    font: var(--text-small)/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .site-demo-drawer input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 0.75rem;
    font: inherit;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    color: var(--color-text);
    background: var(--color-surface);
  }
  .site-demo-drawer button:not(.btn):not([data-drawer-handle]) {
    cursor: pointer;
    font: inherit;
    padding: 0.75rem 1rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .site-demo-drawer [data-drawer-close] {
    position: sticky;
    order: -1;
    flex: 0 0 auto;
    top: 0;
    display: block;
    margin-left: auto;
    z-index: 1;
  }
  .site-demo-drawer [data-drawer-handle] {
    margin-inline: auto;
    order: -2;
    flex-shrink: 0;
    padding: 0;
  }
  .site-demo-drawer button:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .site-demo-drawer button:not(.btn):not([data-drawer-handle]):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .site-demo-drawer .demo-body:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: calc(-1 * var(--focus-width));
  }
  .site-demo-drawer label,
  .site-demo-drawer form {
    display: grid;
    gap: var(--space-sm);
  }
  .site-demo-drawer select,
  .site-demo-drawer textarea {
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    padding: var(--space-sm);
    background: var(--color-surface);
    color: var(--color-text);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    font: inherit;
  }
  .site-demo-drawer .demo-field-inline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .site-demo-drawer .demo-field-inline input {
    width: 1.125rem;
    height: 1.125rem;
    padding: 0;
    flex-shrink: 0;
    accent-color: var(--color-accent);
  }
  .site-demo-drawer .demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .site-demo-drawer h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  .site-demo-drawer section + section {
    margin-top: var(--space-xl);
  }
  .site-demo-drawer section p + p {
    margin-top: var(--space-md);
  }
  .site-demo-drawer [data-flow-step][hidden] {
    display: none;
  }
  .site-demo-drawer [data-flow-step]:not([hidden]) {
    display: grid;
    gap: var(--space-lg);
    margin-top: 0;
  }
  .site-demo-drawer [data-flow-step] > :is(h3, p) {
    margin: 0;
  }
  .site-demo-drawer [data-flow-step] > .btn {
    justify-self: start;
  }
  .site-demo-drawer.demo-floating {
    isolation: isolate;
    background: transparent;
  }
  .site-demo-drawer.demo-floating::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-bg);
    z-index: -1;
    pointer-events: none;
  }
  .site-demo-drawer.demo-invitation::before {
    background-image: linear-gradient(155deg, var(--color-bg) 50%, var(--color-accent-soft));
  }
  .site-demo-drawer.demo-invitation {
    --initial-transform: 100dvh;
    inset: 1rem;
    margin: auto;
    width: min(34rem, calc(100% - 2rem));
    height: fit-content;
    min-height: 0;
    max-height: calc(100dvh - 2rem);
    border-radius: 2rem 0.5rem 2rem 0.5rem;
    border-color: var(--color-accent);
  }
  .site-demo-drawer.demo-invitation button[data-drawer-close] {
    border-radius: var(--radius-pill);
  }
  .site-demo-drawer.demo-independent-notes,
  .site-demo-drawer.demo-independent-activity {
    --initial-transform: 100dvw;
    width: min(27rem, 46vw);
    max-height: calc(100dvh - 2rem);
    top: 1rem;
    bottom: 1rem;
    border-radius: var(--radius-control);
  }
  .site-demo-drawer.demo-independent-notes {
    right: auto;
    left: 1rem;
  }
  .site-demo-drawer.demo-independent-activity {
    left: auto;
    right: 1rem;
  }
  @media (width < 48rem) {
    .site-demo-drawer.demo-independent-notes,
    .site-demo-drawer.demo-independent-activity {
      width: calc(100% - 2rem);
      height: 44dvh;
      max-height: 44dvh;
    }
    .site-demo-drawer.demo-independent-notes {
      top: 1rem;
      bottom: auto;
    }
    .site-demo-drawer.demo-independent-activity {
      top: auto;
      bottom: 1rem;
    }
  }
  @media (width < 37.5rem) {
    .site-demo-drawer {
      --demo-padding: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-demo-drawer,
    .site-demo-overlay {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
