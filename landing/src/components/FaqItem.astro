---
import Disclosure from '../../../shared/components/Disclosure.astro'
---

<Disclosure variant="row" indicator="plus" class:list={['faq-item']}>
  <Fragment slot="summary">
    <slot name="question" />
  </Fragment>
  <div class:list={['answer']}>
    <slot />
  </div>
</Disclosure>

<style>
  .faq-item {
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  .faq-item:last-child {
    border-bottom: 0.0625rem solid var(--color-border-soft);
  }
  .answer {
    padding-bottom: 1.375rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.8;
    max-width: 42rem;
  }
</style>
