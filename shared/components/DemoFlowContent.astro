---
import Button from './Button.astro'
import { flow, type DemoPreset } from '../i18n/translations/en/demo'
const { preset } = Astro.props as { preset: DemoPreset }
const finishId = `finish-${crypto.randomUUID()}`
---

{preset === 'wizard' && (
  <>
    <p class:list={['demo-kicker']} data-flow-progress aria-live="polite">
      {flow.stepLabel} 1 / 3
    </p>
    <section data-flow-step="0">
      <h3 tabindex="-1">{flow.steps[0]}</h3>
      <label for={finishId}>{flow.finish}</label>
      <select id={finishId} data-flow-finish>
        {flow.finishes.map(finish => (
          <option>{finish}</option>
        ))}
      </select>
      <Button data-flow-next>{flow.next}</Button>
    </section>
    <section data-flow-step="1" hidden>
      <h3 tabindex="-1">{flow.steps[1]}</h3>
      <label>
        {flow.initials}
        <input data-flow-initials maxlength="3" placeholder={flow.initialsPlaceholder} />
      </label>
      <p class:list={['demo-hint']}>{flow.initialsHint}</p>
      <div class:list={['demo-actions']}>
        <Button variant="secondary" data-flow-back>
          {flow.back}
        </Button>
        <Button data-flow-next>{flow.next}</Button>
      </div>
    </section>
    <section data-flow-step="2" hidden>
      <h3 tabindex="-1">{flow.steps[2]}</h3>
      <p>{flow.summary}</p>
      <p data-flow-summary></p>
      <div class:list={['demo-actions']}>
        <Button variant="secondary" data-flow-back>
          {flow.back}
        </Button>
        <Button data-flow-confirm>{flow.confirm}</Button>
      </div>
    </section>
  </>
)}
{preset === 'independent' && (
  <>
    <p>{flow.notesHint}</p>
    <label data-drawer-no-drag>
      {flow.notesLabel}
      <textarea placeholder={flow.notesPlaceholder}></textarea>
    </label>
    <Button data-open-companion aria-haspopup="dialog">
      {flow.openActivity}
    </Button>
    <template data-companion-content>
      <div class:list={['demo-body']}>
        {flow.activityEntries.map(entry => (
          <section>
            <h3>{entry.title}</h3>
            <p>{entry.detail}</p>
          </section>
        ))}
      </div>
    </template>
  </>
)}
{preset === 'styled' && (
  <>
    <p class:list={['demo-kicker']}>{flow.styledEyebrow}</p>
    <h3>{flow.styledHeading}</h3>
    <p>{flow.styledBody}</p>
    <p class:list={['demo-hint']}>{flow.styledDetails}</p>
    <Button data-demo-choice={flow.styledAction} data-drawer-no-drag>
      {flow.styledAction}
      <span aria-hidden="true">↗</span>
    </Button>
    <p class:list={['demo-hint']}>{flow.styledNotice}</p>
  </>
)}
