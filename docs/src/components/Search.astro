---
import drawerCss from '@samline/drawer/styles.css?inline'
import { getI18n } from '../i18n/utils'
import TextField from '../../../shared/components/TextField.astro'
import SearchResultCard from './SearchResultCard.astro'
import Icon from '../../../shared/components/Icon.astro'
import Box from '../../../shared/components/Box.astro'
import Button from '../../../shared/components/Button.astro'
import DrawerStyles from '../../../shared/components/DrawerStyles.astro'
const s = getI18n(Astro).search
const id = `docs-search-${crypto.randomUUID()}`
---

<package-site-docs-search
  class:list={['search']}
  data-id={id}
  data-base={import.meta.env.BASE_URL}
  data-title={s.label}
  data-close={s.close}
  data-handle={s.handle}
  data-loading={s.loading}
  data-empty={s.empty}
  data-error={s.error}
  data-count={s.count}
>
  <Button
    variant="ghost"
    class:list={['search-trigger']}
    hidden
    aria-label={s.label}
    aria-haspopup="dialog"
    aria-expanded="false"
    data-search-trigger
  >
    <Icon name="search" />
    <span class:list={['search-label']}>{s.label}</span>
    <kbd aria-hidden="true">{s.hint}</kbd>
  </Button>
  <template>
    <div class:list={['search-content']}>
      <Box size="medium" class:list={['search-intro']} data-drawer-no-drag>
        <div class:list={['search-heading']}>
          <p>{s.label}</p>
          <span id={`${id}-hint`} class:list={['search-hint']}>
            {s.initial}
          </span>
        </div>
        <TextField
          label={s.label}
          id={`${id}-input`}
          type="text"
          role="searchbox"
          inputmode="search"
          placeholder={s.placeholder}
          autocomplete="off"
          aria-controls={`${id}-results`}
          aria-describedby={`${id}-hint`}
        />
      </Box>
      <div class:list={['search-results']} data-drawer-no-drag>
        <Box size="medium">
          <p class:list={['search-status']} role="status" aria-live="polite"></p>
          <ul id={`${id}-results`} aria-label={s.results}></ul>
          <SearchResultCard />
        </Box>
      </div>
    </div>
  </template>
</package-site-docs-search>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'

  import { createDrawer } from '@samline/drawer'
  type Result = {
    url: string
    meta: { title?: string }
    excerpt: string
    sub_results?: { url: string; title: string; excerpt: string }[]
  }
  type Pagefind = {
    options: (config: { baseUrl: string }) => Promise<void>
    search: (query: string) => Promise<{ results: { data: () => Promise<Result> }[] }>
  }
  mountElements('package-site-docs-search', element => {
    let pagefind: Promise<Pagefind> | undefined
    let request = 0
    let timer: ReturnType<typeof setTimeout> | undefined
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const trigger = element.querySelector<HTMLButtonElement>('[data-search-trigger]'),
      template = element.querySelector('template'),
      id = element.dataset.id
    if (!trigger || !template?.content.firstElementChild || !id) return
    const load = () => {
      if (!pagefind) {
        const base = (element.dataset.base ?? '/').replace(/\/$/, '') + '/'
        pagefind = import(
          /* @vite-ignore */ new URL(`${base}pagefind/pagefind.js`, location.origin).href
        )
          .then(async module => {
            const api = module as Pagefind
            await api.options({ baseUrl: base })
            return api
          })
          .catch(error => {
            pagefind = undefined
            throw error
          })
      }
      return pagefind
    }
    const drawer = createDrawer({
      id,
      content: () => template.content.firstElementChild!.cloneNode(true) as HTMLElement,
      container: element,
      triggerElement: trigger,
      direction: 'top',
      showHandle: true,
      handleOnly: true,
      handleAriaLabel: element.dataset.handle,
      handleClassName: 'docs-search-handle',
      autoFocus: true,
      ariaLabel: element.dataset.title,
      contentClassName: 'docs-search-panel',
      overlayClassName: 'docs-search-overlay',
      closeButton: {
        icon: '×',
        className: 'docs-search-close',
        ariaLabel: element.dataset.close,
      },
      onOpenChange: open => {
        trigger.setAttribute('aria-expanded', String(open))
        if (!open) {
          ++request
          clearTimeout(timer)
          return
        }
        // The native handle precedes the field; search should start ready to type.
        queueMicrotask(() => {
          if (!signal.aborted && trigger.getAttribute('aria-expanded') === 'true')
            element.querySelector<HTMLInputElement>('[role=searchbox]')?.focus({
              preventScroll: true,
            })
        })
        load().catch(() => {
          if (!signal.aborted) {
            const status = element.querySelector('[role=status]')
            if (status) status.textContent = element.dataset.error ?? ''
          }
        })
      },
    })
    trigger.hidden = false
    document.addEventListener(
      'keydown',
      event => {
        const activeSearch = document.activeElement?.closest('package-site-docs-search')
        if (event.defaultPrevented || (activeSearch && activeSearch !== element)) return
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault()
          drawer.setOpen(trigger.getAttribute('aria-expanded') !== 'true')
        }
      },
      { signal }
    )
    element.addEventListener(
      'input',
      event => {
        if (!(event.target instanceof HTMLInputElement)) return
        const input = event.target,
          status = element.querySelector('[role=status]'),
          list = element.querySelector('ul')
        if (!status || !list) return
        clearTimeout(timer)
        const currentRequest = ++request
        const query = input.value.trim()
        if (!query) {
          list.replaceChildren()
          status.textContent = ''
          return
        }
        timer = setTimeout(async () => {
          status.textContent = element.dataset.loading ?? ''
          try {
            const api = await load(),
              found = await api.search(query)
            const results = await Promise.all(
              found.results.slice(0, 12).map(result => result.data())
            )
            if (signal.aborted || currentRequest !== request) return
            const cardTemplate =
              element.querySelector<HTMLTemplateElement>('[data-result-template]')
            if (!cardTemplate?.content.firstElementChild) return
            list.replaceChildren()
            for (const result of results) {
              const li = document.createElement('li')
              const link = cardTemplate.content.firstElementChild.cloneNode(
                true
              ) as HTMLAnchorElement
              const title = link.querySelector('[data-result-title]'),
                excerpt = link.querySelector('[data-result-excerpt]'),
                match = result.sub_results?.[0]
              link.href = match?.url ?? result.url
              if (title) title.textContent = result.meta.title ?? match?.title ?? ''
              if (excerpt)
                excerpt.textContent =
                  new DOMParser().parseFromString(match?.excerpt ?? result.excerpt, 'text/html')
                    .body.textContent ?? ''
              li.append(link)
              list.append(li)
            }
            status.textContent = results.length
              ? (element.dataset.count ?? '')
                  .replace('{count}', String(found.results.length))
                  .replace('{shown}', String(results.length))
              : (element.dataset.empty ?? '')
          } catch {
            if (!signal.aborted && currentRequest === request)
              status.textContent = element.dataset.error ?? ''
          }
        }, 300)
      },
      { signal }
    )
    element.addEventListener(
      'click',
      event => {
        if (event.target instanceof Element && event.target.closest('.docs-search-panel a'))
          drawer.setOpen(false)
      },
      { signal }
    )
    return () => {
      lifecycle.abort()
      clearTimeout(timer)
      ++request
      drawer.destroy()
      trigger.setAttribute('aria-expanded', 'false')
    }
  })
</script>
<DrawerStyles scope="package-site-docs-search" css={drawerCss} />
<style>
  .search {
    display: block;
    flex: none;
    min-width: 0;
  }
  [hidden] {
    display: none !important;
  }
  .search .search-trigger {
    width: 2.5rem;
    padding: 0;
    gap: 0.625rem;
  }
  .search-label,
  kbd {
    display: none;
  }
  .search-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding-block: 2rem 3rem;
  }
  .search-intro {
    flex: none;
    padding-bottom: 1.25rem;
    border-bottom: 0.0625rem solid var(--palette-feature-border);
  }
  .search-results {
    min-height: 0;
    flex: 0 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: 0.25rem 1.5rem;
    scrollbar-width: thin;
  }
  .search-content:has(.search-status:empty) .search-results {
    display: none;
  }
  .search-content:has(.search-status:empty) .search-intro {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .search-heading {
    padding-right: 3rem;
    margin-bottom: 1.5rem;
  }
  .search-heading p {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-style: italic;
    color: var(--palette-heading-accent);
    letter-spacing: -0.025em;
    line-height: 1.1;
    font-weight: 400;
    margin: 0 0 0.5rem;
  }
  .search-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .search-status {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin: 1rem 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .search :global(.docs-search-panel) {
    position: fixed;
    inset: 0 0 auto;
    z-index: 101;
    width: 100%;
    display: flex;
    flex-direction: column;
    max-height: min(44rem, calc(100dvh - 1rem));
    overflow: hidden;
    overscroll-behavior: contain;
    background: linear-gradient(135deg, var(--palette-feature-surface), var(--color-bg) 65%);
    color: var(--color-text);
    border-bottom: 0.0625rem solid var(--color-border);
    border-radius: 0;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.2);
  }
  .search :global([data-drawer-body]),
  .search :global([data-drawer-body] > div) {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .search :global(.docs-search-handle) {
    position: absolute;
    bottom: 1.125rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    width: 3rem;
    height: 0.3125rem;
    background: var(--color-accent);
  }
  .search :global(.docs-search-handle:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.375rem;
  }
  .search :global(.docs-search-overlay) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgb(0 0 0 / 0.5);
  }

  @media (width>=64rem) {
    .search .search-trigger {
      width: auto;
      padding-inline: 1rem;
    }
    .search-label,
    kbd {
      display: inline;
    }
    .search-label {
      font-size: 0.8125rem;
    }
    kbd {
      padding: 0.125rem 0.375rem;
      border: 0.0625rem solid var(--color-border-soft);
      border-radius: 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      color: var(--color-text-subtle);
    }
  }
</style>
