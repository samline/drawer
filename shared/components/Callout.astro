---
import type { HTMLAttributes } from 'astro/types'
import Surface from './Surface.astro'
interface Props extends HTMLAttributes<'aside'> {
  title: string
}
const { title, class: className, ...attributes } = Astro.props
const id = `callout-${crypto.randomUUID()}`
---

<Surface {...attributes} as="aside" class:list={['callout', className]} aria-labelledby={id}>
  <p id={id} class:list={['title']}>
    {title}
  </p>
  <div class:list={['body']}>
    <slot />
  </div>
</Surface>

<style>
  .callout {
    margin-block: var(--space-lg);
    padding: 1.25rem;
  }
  .title {
    margin: 0 0 var(--space-xs);
    color: var(--palette-heading-accent);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .body {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
  .body :global(p) {
    margin: 0;
  }
</style>
